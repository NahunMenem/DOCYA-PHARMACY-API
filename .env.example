ENVIRONMENT=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/docya_pharmacy
CORE_API_URL=http://localhost:8000
JWT_SECRET=replace-with-the-same-secret-used-by-docya-core
INTERNAL_API_KEY=replace-with-a-long-random-secret
DB_POOL_MIN_CONNECTIONS=1
DB_POOL_MAX_CONNECTIONS=5
DB_POOL_ACQUIRE_TIMEOUT_SECONDS=5
ALLOWED_ORIGINS=http://localhost:3000
PHARMACY_TOKEN_EXPIRE_MINUTES=720

# Pruebas sin cobro real. Usar "mercadopago" recien cuando OAuth y webhooks
# de las cuentas de las farmacias esten terminados y validados.
PHARMACY_PAYMENT_MODE=simulated
PHARMACY_AUTO_ACTIVATE_TEST_REGISTRATIONS=true
